# Copy to /opt/zestia/application.conf on the VPS and fill privately.
# Values are literal; do not add surrounding quotes to passwords.
# Database host is postgres and port is 5432 inside the Compose network.
# Format: postgresql+psycopg://USER:URL_ENCODED_PASSWORD@postgres:5432/DATABASE
DATABASE_URL=
# Set a generated random secret of at least 32 characters.
JWT_SECRET=
JWT_ISSUER=zestia-production
JWT_AUDIENCE=zestia-api
ACCESS_TOKEN_MINUTES=15
# No cross-origin frontend is configured yet.
CORS_ORIGINS=[]
ADMIN_EMAIL=
ADMIN_PASSWORD=
RECOVERY_EMAIL_ENABLED=false
RECOVERY_TOKEN_MINUTES=15
RECOVERY_WINDOW_SECONDS=60
RECOVERY_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
# Gmail App Password, not the Gmail login password.
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
