# Isolated CI test fixtures only. Never use these credentials for application data.
COMPOSE_PROJECT_NAME=zestia-ci
POSTGRES_USER=zestia_ci
POSTGRES_PASSWORD=zestia-ci-test-fixture-password
POSTGRES_DB=zestia_ci_test
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://zestia_ci:zestia-ci-test-fixture-password@localhost:5432/zestia_ci_test
TEST_DATABASE_URL=postgresql+psycopg://zestia_ci:zestia-ci-test-fixture-password@localhost:5432/zestia_ci_test
JWT_SECRET=zestia-ci-test-fixture-secret-at-least-32-characters
JWT_ISSUER=zestia-ci
JWT_AUDIENCE=zestia-ci-api
ACCESS_TOKEN_MINUTES=15
CORS_ORIGINS=["https://frontend.zestia.test"]

RECOVERY_TOKEN_MINUTES=15
RECOVERY_WINDOW_SECONDS=60
RECOVERY_MAX_ATTEMPTS=5
