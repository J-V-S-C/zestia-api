COMPOSE_PROJECT_NAME=zestia
POSTGRES_USER=zestia
POSTGRES_PASSWORD=replace-with-a-generated-database-password
POSTGRES_DB=zestia
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://zestia:replace-with-a-generated-database-password@localhost:5432/zestia
JWT_SECRET=replace-with-a-generated-random-secret-at-least-32-characters
JWT_ISSUER=zestia
JWT_AUDIENCE=zestia-api
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]
# Required by scripts/verify.py and the commit hook. Use a disposable database ending in _test.
# Verification clears its data and checks migration downgrade/upgrade.
# TEST_DATABASE_URL=postgresql+psycopg://zestia:replace-with-a-generated-database-password@localhost:5432/zestia_test
